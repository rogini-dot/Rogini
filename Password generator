import random
import string

def generate_password(length, use_uppercase, use_lowercase, use_digits, use_specials):
    characters = ''
    
    if use_uppercase:
        characters += string.ascii_uppercase
    if use_lowercase:
        characters += string.ascii_lowercase
    if use_digits:
        characters += string.digits
    if use_specials:
        characters += string.punctuation

    if not characters:
        print("Error: No character types selected. Cannot generate password.")
        return None

    password = ''.join(random.choice(characters) for _ in range(length))
    return password

def get_yes_no_input(prompt):
    while True:
        choice = input(prompt + " (yes/no): ").strip().lower()
        if choice in ['yes', 'no']:
            return choice == 'yes'
        else:
            print("Please enter 'yes' or 'no'.")

def main():
    print("=== Welcome to the Python Password Generator ===")
    
    while True:
        try:
            length = int(input("Enter the desired password length (minimum 4): "))
            if length < 4:
                print("Password length should be at least 4 for good security.")
                continue
        except ValueError:
            print("Please enter a valid number.")
            continue

        print("\nChoose the complexity of your password:")
        use_uppercase = get_yes_no_input("Include uppercase letters (A-Z)?")
        use_lowercase = get_yes_no_input("Include lowercase letters (a-z)?")
        use_digits = get_yes_no_input("Include digits (0-9)?")
        use_specials = get_yes_no_input("Include special characters (!, @, #, etc.)?")

        password = generate_password(length, use_uppercase, use_lowercase, use_digits, use_specials)

        if password:
            print("\nGenerated Password: ", password)

        again = get_yes_no_input("\nDo you want to generate another password?")
        if not again:
            print("Thank you for using the Password Generator. Stay secure!")
            break

# Run the main function
if __name__ == "__main__":
    main()
